import random
import secrets
import hashlib

# Define major variables.
standard_alphabet = list(range(256))
alphabet_list = list(range(256))
result = bytearray()
session_ID = ""


print("WELCOME TO THE VOID.")

# Asks user encrypt or decrypt
mode = input("Would you like to encrypt or decrypt? E for encrypt, D for decrypt. ")

if mode == "E":

    # Ask for key.
    main_key = input("Enter Master Key: ")


    # Ask user for message.
    raw_message = input("INPUT MESSAGE: ")

    # Convert to bytes
    message = raw_message.encode()


    # Collect the ASCII numbers
    key = ""

    # Generate a random session ID
    session_ID += secrets.token_hex(75)

    # Use hashlib to encrypt the key and message into a 64-char hexadecimal.
    hash_key = hashlib.sha256((main_key+session_ID).encode()).hexdigest()

    # Use hashlib to encrpt just the key into a 64-char hexadecimal for the ID.
    ID_hash_key = hashlib.sha256((main_key).encode()).hexdigest()

    # Define 'ID engine' to scramble ID..
    ID_engine = random.Random(ID_hash_key)

    # Turn the ID into a list.
    ID_list = list(session_ID)

    # Shuffle the list
    ID_engine.shuffle(ID_list)

    # Glue them back together.
    scrambled_session_ID = "".join(ID_list)

    # Turn the hexadecimal into a Base-10 integer.
    scramble = int(hash_key, 16)

    # Define 'engine' to scramble alphabet.
    engine = random.Random(scramble)


    # Define 'rotary'.
    rotary = (scramble % 255) + 1

    # Shuffle the list
    engine.shuffle(alphabet_list)

    # Salt the rotors
    alphabet_list = alphabet_list[len(main_key):]+ alphabet_list[:len(main_key)]

    # Run through every character.
    for char in message:

        # Use a binary value to find the equivalent of this byte
        encrypted_byte = alphabet_list[char]
    
        # Add this to the result.
        result.append(encrypted_byte)
        
        # Spin the scrambled alphabet.
        alphabet_list = alphabet_list[rotary % 255:] + alphabet_list[:rotary % 255]
        
        # Accelerate the rotation for the next spin by 1.
        rotary  = rotary + 1
       
        # Shuffle the list
        engine.shuffle(alphabet_list)
    
        # Salt the rotors
        alphabet_list = alphabet_list[len(main_key):]+ alphabet_list[:len(main_key)]
    
    # Print the final, encrypted result.
    print(scrambled_session_ID + result.hex())






elif mode == "D":

    # Ask for key.
    main_key = input("Enter Master Key: ")

    # Ask user for message.
    message_and_code = input("INPUT MESSAGE: ")

    # Collect the ASCII numbers
    key = ""

    # Separate the scrambled ID from the ciphertext
    scrambled_id_part = message_and_code[:150]
    message = message_and_code[150:] 

    # Recreate the ID_hash_key to get the same seed
    ID_hash_key = hashlib.sha256((main_key).encode()).hexdigest()
    ID_engine = random.Random(ID_hash_key)

    # Create a list of numbers that how ID may have shuffled
    indices = list(range(150))

    # Shuffle these positions exactly how the ID was shuffled
    ID_engine.shuffle(indices)
    
    # Place each character from the scrambled ID back into its original slot
    unscrambled_list = [None] * 150
    for i, original_pos in enumerate(indices):
        unscrambled_list[original_pos] = scrambled_id_part[i]
    
    unscrambled_session_ID = "".join(unscrambled_list)

    # Reconstruct the Master hash_key used for the alphabet
    hash_key = hashlib.sha256((main_key + unscrambled_session_ID).encode()).hexdigest()
    scramble = int(hash_key, 16)

    #Convert message into bytes.
    message = bytes.fromhex(message)
    
    # Define 'rotary'.
    rotary = (scramble % 255) + 1


    # Scramble the alphabet using scramble seed.
    engine = random.Random(scramble)

    # Shuffle the list
    engine.shuffle(alphabet_list)
    
    # Salt the rotors
    alphabet_list = alphabet_list[len(main_key):]+ alphabet_list[:len(main_key)]
    
    #Run through every character.
    for char in message:
        # Find the position of the original character in the scrambled alphabet.
        original_byte = alphabet_list.index(char)

        
        # Add this to the result.
        result.append(original_byte)

        #Spin the scrambled alphabet.
        alphabet_list = alphabet_list[rotary % 255:] + alphabet_list[:rotary % 255]
        

        # Shuffle the list
        engine.shuffle(alphabet_list)
    
        # Salt the rotors
        alphabet_list = alphabet_list[len(main_key):]+ alphabet_list[:len(main_key)]
        
        # Accelerate the rotation for the next spin by 1.
        rotary  = rotary + 1
        
    # Print the final, decrypted result.
    print(result.decode())
